Mods: {
	BagofChaos: {
		Items: {
			GooglyEyeAmmo: {
				DisplayName: Googly Eye Ammo
				Tooltip:
					'''
					Puts googly eyes on whatever it hits
					They never stop watching
					'''
			}

			YoureLongAmmo: {
				DisplayName: You're Long?
				Tooltip:
					'''
					Stretches the target's sprite to four times its width
					The hitbox stays exactly where it was. Good luck.
					'''
			}

			YoureTallAmmo: {
				DisplayName: You're Tall?
				Tooltip:
					'''
					Stretches the target's sprite to four times its height
					The hitbox stays exactly where it was. Mind your head.
					'''
			}

			BuddySystemBullet: {
				DisplayName: Buddy System Bullet
				Tooltip:
					'''
					Applies Life Link
					Every linked enemy on screen takes every hit any of them takes
					This does not split the damage. It copies it.
					'''
			}

			ChaosSolution: {
				DisplayName: Chaos Solution
				Tooltip:
					'''
					Used by the Clentaminator
					Converts blocks into other, completely random blocks
					Your base was nice. Was.
					'''
			}

			GlueGun: {
				DisplayName: Glue Gun
				Tooltip:
					'''
					Like a paint sprayer, but glue. Glued things stick to what they touch for 5 seconds.
					Glued enemies also get Life Link and a white outline. Fire burns it all away.
					'''
			}

			ChainCan: {
				DisplayName: Chain Can
				Tooltip:
					'''
					Enemies hit summon tin cans next to them
					Shoot the cans to blow them up
					Please recycle
					'''
			}

			VenomSnake: {
				DisplayName: Venom Snake
				Tooltip:
					'''
					All bullets inflict Venom
					Kept you waiting, huh?
					'''
			}

			RattlingGun: {
				DisplayName: Rattling Gun
				Tooltip:
					'''
					Fires high speed rats
					Rats die on impact, deal damage and inflict Poison
					Converts any bullet into a rat. Don't ask how.
					'''
			}

			ToolGun: {
				DisplayName: Tool Gun
				Tooltip:
					'''
					Duplicates any NPC it hits
					Any NPC
					Think about it
					'''
			}

			ToolMinigun: {
				DisplayName: Tool Minigun
				Tooltip:
					'''
					Rapid fire duplication of any NPC it hits
					You didn't think about it
					'''
			}

			CreditCannon: {
				DisplayName: Credit Cannon
				Tooltip:
					'''
					Uses rockets
					Deals 100x damage, but only while the end credits are rolling
					The game is over. Go nuts.
					'''
			}

			FartReverb: {
				DisplayName: Fart Reverb.mp3
				Tooltip:
					'''
					Deals 1 damage
					Knockback is measured in screens. For everyone but you: you get about three tiles.
					Affects enemies, town folk and other players
					'''
			}

			SpriteSlasher: {
				DisplayName: Sprite Slasher
				Tooltip:
					'''
					Cuts the enemy's sprite in half and flips the halves
					Legs on heads. Heads on legs. Permanently.
					Purely cosmetic. The anatomy is a lie.
					'''
			}

			PongPower: {
				DisplayName: Pong Power
				Tooltip:
					'''
					Two big paddles follow your cursor at the top and bottom of the screen
					Click to serve a ball that grows and hits harder with every bounce (up to 5 balls)
					Balls bounce off enemies back to the paddles and pop after 5 paddle bounces
					Miss the ball and it's gone. Scales with summon damage.
					'''
			}

			GreenPongPower: {
				DisplayName: Green Pong Power
				Tooltip:
					'''
					Four longer paddles follow your cursor on every edge of the screen
					Ball speed doubled, up to 10 balls at once
					Balls bounce off enemies back to the paddles and pop after 5 paddle bounces
					It's green. That means it's better.
					'''
			}

			PocketRats: {
				DisplayName: Pocket Rats
				Tooltip:
					'''
					Throws a constant barrage of rats
					Rats burst into poison clouds on impact
					Where do they keep coming from
					'''
			}

			GparrlingHook: {
				DisplayName: Gparrling Hook
				Tooltip:
					'''
					Pulls the hooked NPC to you, fast. Short range.
					Ignores gravity, weight and knockback resistance
					Yes, bosses too. No, this was not a good idea.
					'''
			}

			NPCLawnmower: {
				DisplayName: NPC Lawnmower
				Tooltip:
					'''
					Keeps your town nice and tidy
					Kills non-hostile NPCs on contact. Critters included.
					Does not hurt enemies. It's a lawnmower, not a weapon.
					'''
			}

			BlockRod: {
				DisplayName: Block Rod
				Tooltip:
					'''
					Click and drag to pick up a chunk of blocks (up to 24x24)
					Left click to place it precisely, right click to put it back
					Furniture and other delicate things stay where they are
					'''
			}

			NPCHand: {
				DisplayName: NPC Hand
				Tooltip:
					'''
					Click and drag to pick up and move any NPC
					Deals no damage
					Rearrange your town. Or the Eye of Cthulhu.
					'''
			}

			InstantUpDown: {
				DisplayName: Instant Up/Down
				Tooltip:
					'''
					Pressing Up or Down instantly sets your vertical speed to its maximum
					Holding Up is basically flight. Nobody tested this.
					'''
			}

			InstantLeftRight: {
				DisplayName: Instant Left/Right
				Tooltip:
					'''
					Pressing Left or Right instantly sets your horizontal speed to its maximum
					Zero to max speed instantly. Normal speed limits apply.
					'''
			}

			UnreasonableUpDown: {
				DisplayName: Unreasonable Up/Down
				Tooltip:
					'''
					Pressing Up or Down instantly sets your vertical speed to an unreasonable value
					Three times as unreasonable as it used to be. Ignores every speed limit the game has.
					'''
			}

			UnreasonableLeftRight: {
				DisplayName: Unreasonable Left/Right
				Tooltip:
					'''
					Pressing Left or Right instantly sets your horizontal speed to an unreasonable value
					Three times as unreasonable as it used to be. Ignores every speed limit the game has.
					'''
			}

			InstantOmniMovement: {
				DisplayName: Instant Omni Movement
				Tooltip:
					'''
					Pressing any direction instantly sets your speed along that axis to four times unreasonable
					Releasing a key does NOT remove momentum. Opposite key reverses it.
					No diagonal normalization. No brakes. Walls are the brakes.
					'''
			}

			SkyInABottle: {
				DisplayName: Sky in a Bottle
				Tooltip:
					'''
					A cloud platform appears under your feet whenever a jump reaches its maximum height
					Everyone can stand on it. It fades after a few seconds no matter what.
					'''
			}

			RocketPack: {
				DisplayName: Rocket Pack
				Tooltip:
					'''
					Replaces your dash with a GIGA rocket transformation
					Double tap a direction to launch. Very fast. Very far. Explodes on impact with terrain or enemies.
					Explosion damage scales with your melee damage and max life
					'''
			}

			DrillerPack: {
				DisplayName: Driller Pack
				Tooltip:
					'''
					Replaces your dash with a mining drill dash
					Double tap a direction to drill through blocks like a mole cart
					Pickaxe power: 55%
					'''
			}

			DrillerPackHellstone: {
				DisplayName: Hellstone Driller Pack
				Tooltip:
					'''
					Replaces your dash with a mining drill dash
					Double tap a direction to drill through blocks like a mole cart
					Pickaxe power: 100%
					'''
			}

			DrillerPackChlorophyte: {
				DisplayName: Chlorophyte Driller Pack
				Tooltip:
					'''
					Replaces your dash with a mining drill dash
					Double tap a direction to drill through blocks like a mole cart
					Pickaxe power: 200%
					'''
			}

			DrillerPackLuminite: {
				DisplayName: Luminite Driller Pack
				Tooltip:
					'''
					Replaces your dash with a mining drill dash
					Double tap a direction to drill through blocks like a mole cart
					Pickaxe power: 230%. There is nothing you cannot drill.
					'''
			}

			LiquidSnake: {
				DisplayName: Liquid Snake
				Tooltip:
					'''
					You move through liquids at full speed
					Water, lava, honey, shimmer. Full speed. Liquid.
					'''
			}

			ThreeDGlasses: {
				DisplayName: 3D Glasses
				Tooltip:
					'''
					Prevents the 3D debuff
					You somehow had the exact glasses for this bizarre situation
					'''
			}

			ExplosiveHealingKit: {
				DisplayName: Explosive Healing Kit
				Tooltip:
					'''
					Your explosives heal instead of dealing damage or destroying blocks
					Heals every player and friendly NPC in the blast, including you
					Enemies take zero damage. Rockets are now a support class.
					'''
			}

			TMFlash: {
				DisplayName: TM Flash
				Tooltip:
					'''
					Only works in the Underground and Cavern layers
					40% increased damage, but you can only see about 10 tiles
					Disables homing on your bullets and magic
					Flash was never a good move and this does not change that
					'''
			}

			TextBoxingGloves: {
				DisplayName: Text Boxing Gloves
				Tooltip:
					'''
					While equipped, all text on screen has a hitbox that damages enemies
					Damage numbers hurt. Item pickup text hurts. Words hurt.
					Longer text hits harder
					'''
			}

			MuncherMask: {
				DisplayName: Muncher Mask
				Tooltip: Instantly eats any block at head level that you walk into, using your best pickaxe's power
				SetBonus: Munch munch munch: every block eaten restores 1 life
			}

			MuncherShirt: {
				DisplayName: Muncher Shirt
				Tooltip: Instantly eats any block at chest level that you walk into, using your best pickaxe's power
			}

			MuncherShoes: {
				DisplayName: Muncher Shoes
				Tooltip: Instantly eats any block at foot level that you walk into, using your best pickaxe's power
			}

			DrinkableAir: {
				DisplayName: Drinkable Air
				Tooltip:
					'''
					It's air. You drink it. What did you expect?
					Restores your entire breath meter. Drink it anywhere, any time, even with full lungs.
					10 second cooldown. You might drown waiting. That's the point.
					'''
			}

			DrinkableLava: {
				DisplayName: Drinkable Lava
				Tooltip:
					'''
					Kills you instantly
					Yes, really. It's lava. You drink it.
					'''
			}

			SolidSnake: {
				DisplayName: Solid Snake
				Tooltip:
					'''
					Phase through blocks for 10 seconds
					Hold Up to climb. Does NOT prevent fall damage.
					"It's just a box"
					'''
			}

			ThreeDMovieTicket: {
				DisplayName: 3D Movie Ticket
				Tooltip:
					'''
					Admit one
					Gives you the 3D debuff for a minute
					Glasses sold separately
					'''
			}

			WeedyBeer: {
				DisplayName: Weedy Beer
				Tooltip:
					'''
					Every NPC, player and enemy gets an upside-down reflection right under your feet
					Lasts ten minutes. Drink more to stack the distortion, up to five tiers.
					'''
			}

			Monst3rItem: {
				DisplayName: Monst3r
				Tooltip:
					'''
					Summons a floating chibi Monst3r to light your way
					(Placeholder art. He deserves better.)
					'''
			}

			KaltsitItem: {
				DisplayName: Kal'tsit
				Tooltip:
					'''
					Summons a floating chibi Kal'tsit to judge you silently
					(Placeholder art. She would not approve.)
					'''
			}

			DeliriumPills: {
				DisplayName: Delirium Pills
				Tooltip:
					'''
					Starts the Delirium Moon tonight (night only)
					Every enemy becomes a silhouette and one swaps places with you every 10-15 seconds
					Also happens on its own on one new moon in three
					'''
			}

			PinkSlip: {
				DisplayName: Pink Slip
				Tooltip:
					'''
					Summons the Corporate Zombie Invasion (night only, they clock out at dawn)
					Lay off 50 zombies to end it. All zombies now sell 3D TVs on contact.
					We regret to inform you that your position has been eliminated
					'''
			}

			MoonShoes: {
				DisplayName: Moon Shoes
				Tooltip:
					'''
					Starts the Night of Moon Shoes (night only)
					All NPCs have half gravity until dawn
					Can also happen on its own. Nobody can stop it.
					'''
			}

			SlipperyFrogItem: {
				DisplayName: Slippery Frog
				Tooltip: It slides. It teleports. It does not care.
			}

			AlchemicalDehydrator: {
				DisplayName: Alchemical Dehydrator
				Tooltip:
					'''
					Works like an Extractinator: hold a critter, fish or plant and right click the machine
					Hold right click to process a whole stack quickly
					Gold critters, dye plants and quest fish yield 6 to 31 ingredients
					'''
			}

			RainInABottle: {
				DisplayName: Rain in a Bottle
				Tooltip:
					'''
					Place it to make it rain, everywhere, forever
					Last beacon placed wins. Break it to let the weather be weather again.
					'''
			}

			StormInABottle: {
				DisplayName: Storm in a Bottle
				Tooltip:
					'''
					Place it for a permanent thunderstorm
					Last beacon placed wins. Break it to let the weather be weather again.
					'''
			}

			BlizzardInABottle: {
				DisplayName: Blizzard in a Bottle
				Tooltip:
					'''
					Place it for permanent rain with howling wind (a blizzard in snow biomes)
					Last beacon placed wins. Break it to let the weather be weather again.
					'''
			}

			SunshineInABottle: {
				DisplayName: Sunshine in a Bottle
				Tooltip:
					'''
					Place it to banish rain, wind and sandstorms
					Last beacon placed wins. Break it to let the weather be weather again.
					'''
			}

			SandstormInABottle: {
				DisplayName: Sandstorm in a Bottle
				Tooltip:
					'''
					Place it for a permanent sandstorm
					Last beacon placed wins. Break it to let the weather be weather again.
					'''
			}

			JellyStormInABottle: {
				DisplayName: Bouncing Jelly Storm in a Bottle
				Tooltip:
					'''
					Place it: it rains, NPCs deal no contact damage, and players, NPCs and enemies all bounce off each other. Hard.
					Right click the beacon to toggle it.
					'''
			}

			FrogRainInABottle: {
				DisplayName: Slippery Frog Rain in a Bottle
				Tooltip:
					'''
					Place it: it rains, every block is ice (no slowing down) and you run twice as fast on them
					The frogs come out. Right click the beacon to toggle it.
					'''
			}
			SpiderOnABallItem: {
				DisplayName: Spider on a Ball
				Tooltip:
					'''
					Summons a spinning spider on top of a spinning ball
					It doesn't make sense. Shimmer the Balls of Spiders to get it.
					'''
			}

			HollowBlock: {
				DisplayName: Hollow Block
				Tooltip:
					'''
					Solid for everything except players
					Walk right through. Watch the zombies not.
					'''
			}

			BlueCoreBlock: {
				DisplayName: Blue Core Block
				Tooltip:
					'''
					Solid for everything except enemies
					Keep your town NPCs in. Let the zombies... hm.
					'''
			}

			ModelDemonAltar: {
				DisplayName: Model Demon Altar
				Tooltip:
					'''
					Crafts everything a Demon Altar can
					Glows blue, mines like a normal tile, spawns no ores. A replica.
					'''
			}

			ChaoticDehydrator: {
				DisplayName: Chaotic Dehydrator
				Tooltip:
					'''
					Works like an Extractinator for literally any item
					Put anything in. Get anything out. Hold right click to feed it fast.
					'''
			}

			TriforceOfWisdom: {
				DisplayName: Triforce of Wisdom
				Tooltip:
					'''
					Melee and ranged damage count as magic damage
					-10% damage
					'''
			}

			TriforceOfPower: {
				DisplayName: Triforce of Power
				Tooltip:
					'''
					Magic and ranged damage count as melee damage
					-10% damage
					'''
			}

			TriforceOfCourage: {
				DisplayName: Triforce of Courage
				Tooltip:
					'''
					Melee and magic damage count as ranged damage
					-10% damage
					'''
			}

			CompleteTriforceOfHyrule: {
				ModeMagic: The Triforce glows blue. Everything is magic now.
				ModeMelee: The Triforce glows red. Everything is melee now.
				ModeRanged: The Triforce glows green. Everything is ranged now.
				ModeSummon: The Triforce glows yellow. Everything is summon now.
				DisplayName: Complete Triforce of Hyrule
				Tooltip:
					'''
					All vanilla damage bonuses apply to all vanilla damage types
					Right click to choose what everything converts into (Blue: Magic, Red: Melee, Green: Ranged, Yellow: Summoner)
					-10% damage. The legend says nothing about balance.
					'''
			}

			Stalemate: {
				DisplayName: Stalemate
				Tooltip:
					'''
					You can't hurt enemies and they can't hurt you
					You can't heal or regenerate either. Debuffs, traps and lava still count.
					Nobody wins. That's the point.
					'''
			}

			LootScanner: {
				DisplayName: Loot Scanner
				Tooltip: Enemies tagged by whips drop their loot twice
			}

			TouchGrass: {
				DisplayName: Touch Grass
				Tooltip:
					'''
					+5 life regen while standing on grass
					Regular, corrupt or crimson grass only. Hallowed grass is too fancy.
					'''
			}

			SlipperyFrogShoes: {
				DisplayName: Slippery Frog Shoes
				Tooltip:
					'''
					You can no longer move up or down
					Gravity doesn't apply to you. Walk on air. Forever at this height.
					'''
			}

			NTerraria: {
				DisplayName: N-Terraria
				Tooltip:
					'''
					Inverts every colour on screen
					Cursed. Cosmetic. Cursed.
					'''
			}

			UnstableConcoction: {
				RolledDamage: Unstable: +50% damage!
				RolledSpeed: Unstable: +50% weapon attack speed!
				DisplayName: Unstable Concoction
				Tooltip:
					'''
					Potions no longer heal you
					While potion sick: you can't die, your HP can't drop below 1, and you randomly get +50% damage or +50% weapon attack speed
					When potion sickness ends you explode for 60 magic damage and die instantly
					Science!
					'''
			}

			TeamTether: {
				DisplayName: Team Tether
				Tooltip:
					'''
					You can't grapple manually anymore
					Automatically hooks a nearby ally under 25% HP, pulls them to you and heals them for 25% of their max HP
					Players holding their own tether can be pulled but not healed. 60 second cooldown per target.
					'''
			}

			BallsOfSpiders: {
				DisplayName: Balls of Spiders
				Tooltip:
					'''
					Wings with the stats of Leaf Wings
					Constantly drops spiders while flying. Cling to walls by pushing into them.
					Shimmer it into a Spider on a Ball.
					'''
			}

			BallOfSpiders: {
				DisplayName: Ball of Spiders
				Tooltip:
					'''
					Permanent: cobwebs no longer affect you
					Eat it. Shimmer it into Balls of Spiders instead if you must.
					'''
			}

			BallOfConfetti: {
				DisplayName: Ball of Confetti
				Tooltip:
					'''
					Permanent: you explode into confetti when you take damage
					Shimmer it into Balls of Confetti.
					'''
			}

			BallOfGlue: {
				DisplayName: Ball of Glue
				Tooltip:
					'''
					Permanent: removes the Ball of Confetti buff
					Eat another Ball of Confetti to get it back.
					'''
			}

			PullTheLeverKronk: {
				Used: WRONG LEVEEEER
				DisplayName: Pull the Lever, Kronk!
				Tooltip:
					'''
					Creates an instant hellevator under your feet
					Wrong lever!
					'''
			}

			CrushedGlassPotion: {
				DisplayName: Crushed Glass Potion
				Tooltip:
					'''
					All glass and sand related blocks are invisible to you
					15 minute duration
					'''
			}

			CrushedDirtPotion: {
				DisplayName: Crushed Dirt Potion
				Tooltip:
					'''
					Dirt blocks glow unreasonably bright
					5 minute duration
					'''
			}

			CompressedLifeCrystal: {
				DisplayName: Compressed Life Crystal
				Tooltip:
					'''
					Maxes out your red hearts
					Once your base HP is 400 or more it acts as an infinite Lesser Healing Potion
					'''
			}

			CompressedManaCrystal: {
				DisplayName: Compressed Mana Crystal
				Tooltip:
					'''
					Maxes out your mana stars
					Once your base mana is 200 or more it acts as an infinite Lesser Mana Potion
					'''
			}

			CompressedLifeFruit: {
				DisplayName: Compressed Life Fruit
				Tooltip:
					'''
					Maxes out your red and golden hearts
					Once your base HP is 500 or more it acts as an infinite Greater Healing Potion
					'''
			}

			RatPackageCo: {
				DisplayName: Rat Package Co.
				Tooltip:
					'''
					Permanent: expands your inventory down by one row
					The rats deliver. The rats always deliver.
					'''
			}

			BottledPrehardmode: {
				DisplayName: Bottled Prehardmode
				Tooltip:
					'''
					Throw it to release 10 random pre-hardmode enemies
					0.1% chance to release a pre-hardmode boss you've already beaten
					'''
			}

			BottledHardmode: {
				DisplayName: Bottled Hardmode
				Tooltip:
					'''
					Throw it to release 10 random hardmode enemies
					0.1% chance to release a hardmode boss you've already beaten
					'''
			}

			BiomedBottledPrehardmode: {
				DisplayName: Biome'd Bottled Prehardmode
				Tooltip:
					'''
					Throw it to release 10 random pre-hardmode enemies from the biome you're in
					0.1% chance to release a pre-hardmode boss you've already beaten
					'''
			}

			BiomedBottledHardmode: {
				DisplayName: Biome'd Bottled Hardmode
				Tooltip:
					'''
					Throw it to release 10 random hardmode enemies from the biome you're in
					0.1% chance to release a hardmode boss you've already beaten
					'''
			}

			ChaoticGel: {
				DisplayName: Chaotic Gel
				Tooltip:
					'''
					Summons the Chaotic Slime
					Hardmode only
					'''
			}

			SlotMachineToken: {
				DisplayName: Slot Machine Token
				Tooltip:
					'''
					Summons the Slot-bar Caterpillar
					Hardmode only. Keep an eye on your bottom row.
					'''
			}

			BonePile: {
				DisplayName: Bone Pile
				Tooltip:
					'''
					Summons the Bonemass of Skeletron
					Night only. It also shows up on its own one time in four when Skeletron is cursed.
					'''
			}

			CaterpillarBag: {
				DisplayName: Treasure Bag (Slot-bar Caterpillar)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}

			ChaoticSlimeBag: {
				DisplayName: Treasure Bag (Chaotic Slime)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}

			HarpyWings: {
				DisplayName: "\"Harpy\" Wings"
				Tooltip:
					'''
					Summons a harpy that sits behind your head
					Hold jump in the air to glide as if you had wings. You don't. She does.
					'''
			}

			RatCart: {
				DisplayName: Rat Cart
				Tooltip:
					'''
					Summons a rideable rat minecart
					Squeaks occasionally. Faster underground.
					'''
			}

			Sharkboard: {
				DisplayName: Sharkboard
				Tooltip:
					'''
					Summons a rideable shark
					Breathe underwater and move much faster in it. Drops from sharks, who are not happy about it.
					'''
			}

			GuidesGuidebookOfGuiding: {
				DisplayName: Guide's Guidebook of Guiding
				Tooltip:
					'''
					Right click to talk to the Guide from anywhere
					Right click again to close. Requires a living Guide, which is on you.
					'''
			}

			ShopkeepersPortableShopOfKeeping: {
				DisplayName: Shopkeeper's Portable Shop of Keeping
				Tooltip:
					'''
					Right click to open a sell-only shop from anywhere
					Right click again to close. Nothing to buy. Everything to sell.
					'''
			}

			GoblinYourMoney: {
				DisplayName: Goblin' Your Money
				Tooltip:
					'''
					Right click to open the Goblin Tinkerer's reforge menu from anywhere
					Right click again to close
					'''
			}

			SnippingTool: {
				DisplayName: Snipping Tool
				Tooltip:
					'''
					Right click to open the Stylist's hair menu from anywhere
					Right click again to close
					'''
			}

			AnglersPocketguide: {
				DisplayName: Angler's Pocketguide
				Tooltip:
					'''
					Right click to check the Angler's fishing quest from anywhere
					Right click again to close
					'''
			}

			NPCDirectory: {
				DisplayName: NPC Directory
				Tooltip:
					'''
					Right click to open a list of every town NPC living in your world
					Pick one to talk to them from wherever you are
					'''
			}

			GentlemenStack: {
				DisplayName: Gentlemen, Stack.
				Tooltip:
					'''
					All items in your inventory stack to at least 99 while you carry this
					Items that already stack higher are unaffected
					'''
			}

			ChaoticQuiver: {
				DisplayName: Chaotic Quiver
				Tooltip:
					'''
					Bows randomly fire any arrow you carry
					+1 base arrow damage per distinct arrow type when carrying 2 or more
					'''
			}

			ChaoticAmmoBox: {
				DisplayName: Chaotic Ammo Box
				Tooltip:
					'''
					Guns randomly fire any bullet you carry
					+1 base bullet damage per distinct bullet type when carrying 2 or more
					'''
			}

			ChaoticAmmunitionRoulette: {
				DisplayName: Chaotic Ammunition Roulette
				Tooltip:
					'''
					Bows and guns randomly fire any arrow OR bullet you carry
					+1 base damage per distinct ammo type across both categories
					'''
			}

			ChaoticDashBox: {
				DisplayName: Chaotic Dash Box
				Tooltip:
					'''
					Dashes have no cooldown and chain twice
					But they go in a random direction. Chained dashes follow the first.
					'''
			}

			ChaoticBanker: {
				DisplayName: Chaotic Banker
				Tooltip:
					'''
					Passive tools work from inside your Piggy Bank and Safe
					Guide to Critter Companionship, Cell Phone, chaotic ammo tools, and so on
					'''
			}

			RubberBandingBanditMask: {
				DisplayName: Rubber Banding Bandit Mask
				Tooltip:
					'''
					15% increased ranged damage and 10% increased ranged attack speed
					10% chance not to consume ammo
					'''
			}

			RubberBandingBanditBandana: {
				DisplayName: Rubber Banding Bandit Bandana
				Tooltip:
					'''
					15% increased magic damage and 12% reduced mana cost
					Your projectiles bounce off allies in the direction they are facing
					'''
			}

			RubberBandingBanditGoggles: {
				DisplayName: Rubber Banding Bandit Goggles
				Tooltip:
					'''
					15% increased summon damage and +2 minion slots
					You can grapple onto your minions
					'''
			}

			RubberBandingBanditWarpaint: {
				DisplayName: Rubber Banding Bandit Warpaint
				Tooltip:
					'''
					15% increased melee damage and 10% increased melee attack speed
					Taking damage from a projectile gives you a massive burst of movement speed
					'''
			}

			RubberBandingBanditSuit: {
				SetBonus: All your projectiles have a 50% chance to bounce off tiles, +1 bounce for weapon projectiles
				DisplayName: Rubber Banding Bandit Suit
				Tooltip:
					'''
					8% increased damage
					10% chance for ANY projectile to bounce off you
					'''
			}

			RubberBandingBanditShoes: {
				DisplayName: Rubber Banding Bandit Shoes
				Tooltip:
					'''
					6% increased damage and 15% increased movement speed
					You bounce uncontrollably off tiles and enemies
					'''
			}

			ChaoticSwordBox: {
				DisplayName: Chaotic Sword Box
				Tooltip:
					'''
					Attacking randomly swings a sword from your hotbar
					+10 base melee damage
					'''
			}

			ChaoticRangerBox: {
				DisplayName: Chaotic Ranger Box
				Tooltip:
					'''
					Attacking randomly fires a ranged weapon from your hotbar
					+10 base ranged damage
					'''
			}

			ChaoticMagicBox: {
				DisplayName: Chaotic Magic Box
				Tooltip:
					'''
					Attacking randomly casts a magic weapon from your hotbar
					+10 base magic damage
					'''
			}

			ChaoticWhipBox: {
				DisplayName: Chaotic Whip Box
				Tooltip:
					'''
					Attacking randomly cracks a whip from your hotbar
					+10 base summon damage
					'''
			}

			SlotterPillar: {
				DisplayName: Slotter Pillar
				Tooltip:
					'''
					Your inventory slots become minions, but only while your inventory is open
					Random slots dash at enemies and return. Closing the inventory recalls them all.
					'''
			}

			TanningMirror: {
				DisplayName: Tanning Mirror
				Tooltip:
					'''
					Hold it to shine a 75 degree cone of light above you
					Enemies in the cone are tagged once a second; tagged enemies take extra minion damage
					Your minions are kept inside the cone, move faster, and bounce off its edges and each other
					'''
			}

			NailAndHammer: {
				DisplayName: Nail and Hammer
				Tooltip:
					'''
					Left click to throw nails that apply the Nails debuff
					Right click to slam down a hammer that deals triple damage to nailed enemies
					'''
			}

			SnailFlail: {
				DisplayName: Snail Flail
				Tooltip:
					'''
					Killing blows turn enemies into snails
					Their loot is replaced with snails. Just snails.
					'''
			}

			HotSnailFlail: {
				DisplayName: Hot Snail Flail
				Tooltip:
					'''
					Killing blows turn enemies into magma snails
					Their loot is replaced with magma snails. Sets things on fire.
					'''
			}

			BallsOfConfetti: {
				DisplayName: Balls of Confetti
				Tooltip:
					'''
					Light disc that does 1 damage, pierces infinitely, ignores immunity frames and defense
					Stacks to 10, throw one per stack. The Party Girl drops them in hardmode.
					'''
			}

			AxeMeAQuestion: {
				DisplayName: Axe Me a Question
				Tooltip:
					'''
					A throwable axe that damages any tree it hits
					20% chance to confuse enemies
					'''
			}

			AxeMeLotsOfQuestions: {
				DisplayName: Axe Me Lots of Questions
				Tooltip:
					'''
					A throwable axe that instantly chops down any tree it hits
					50% chance to confuse enemies
					'''
			}

			RatTacks: {
				ModeSummon: Rat Tacks: summon damage
				ModeMelee: Rat Tacks: melee damage
				DisplayName: Rat Tacks
				Tooltip:
					'''
					Throws 2-3 rats on the ground that bite anything that touches them
					Right click to toggle between melee and summon damage
					Up to 20 at a time, 40 seconds each
					'''
			}

			DootDoot: {
				DisplayName: Doot Doot
				Tooltip:
					'''
					A repeater that converts arrows into skeletons
					That's right. The entire skeleton.
					'''
			}

			ChainedChainsaw: {
				DisplayName: Chained Chainsaw
				Tooltip: A cobalt chainsaw yo-yo on a chain
			}

			GravityFlail: {
				DisplayName: Gravity Flail
				Tooltip:
					'''
					Enemies hit are slammed into the ground
					They take bonus damage based on how far they fell. This is not capped.
					'''
			}

			BBQSkewer: {
				DisplayName: BBQ Skewer
				Tooltip:
					'''
					Hold the attack button to stick out a metal skewer
					Stabbed enemies get stuck on it, can't move, and cook slowly
					The skewer gets longer with every enemy on it
					'''
			}

			StacksOfFish: {
				DisplayName: Stacks of Fish
				Tooltip:
					'''
					Summons three goldfish that sit on your head
					Three fish take one minion slot. More fish stack higher.
					'''
			}

			Succ: {
				DisplayName: Succ.
				Tooltip:
					'''
					Pulls every town NPC and player on screen to you
					Through walls. Succ.
					'''
			}

			FartReverbMp4: {
				DisplayName: Fart Reverb.mp4
				Tooltip:
					'''
					Hold to charge for up to 20 seconds, release to detonate
					Deals up to 800 damage to everything, including you, and blows up blocks within up to 50 tiles
					Using it at full charge petrifies you for 10 seconds. Has unknown power and consequences.
					'''
			}

			BagOfChaosItem: {
				DisplayName: Bag of Chaos
				Tooltip:
					'''
					Randomly uses any item in the game
					Extremely insane speed. Extremely insane everything.
					'''
			}

			WoopsAllArrows: {
				DisplayName: Woops! All Arrows!
				Tooltip:
					'''
					1 base damage, ignores immunity frames and defense
					On hitting an enemy it explodes into extra arrows equal to twice the number of unique bosses killed in this world
					'''
			}

			ArrowOfReplication: {
				DisplayName: Arrow of Replication
				Tooltip:
					'''
					Firing one duplicates every arrow you currently have in flight
					Duplicates can't make more duplicates. Each duplicate consumes an arrow from your inventory.
					'''
			}

			SlottingPillarAmmo: {
				DisplayName: Slotting Pillar
				Tooltip:
					'''
					Infinite ammo for bows and guns, but only while your inventory is open
					Fires a random inventory slot (never the hotbar) that boomerangs back after it hits something
					'''
			}
		}

